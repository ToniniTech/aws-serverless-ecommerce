# Copy to backend.tf only after the state bucket has been provisioned outside this root.
# Values are examples; never share one state key between environments.
terraform {
  backend "s3" {
    bucket       = "replace-with-terraform-state-bucket"
    key          = "serverless-ecommerce/dev/terraform.tfstate"
    region       = "sa-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
