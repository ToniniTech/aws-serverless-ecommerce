aws_region  = "sa-east-1"
environment = "dev"

# Set this before applying to protect against using the wrong authenticated account.
# expected_aws_account_id = "123456789012"

log_retention_days = 14

payment_lambda_timeout_seconds                    = 30
notification_lambda_timeout_seconds               = 15
order_payment_result_lambda_timeout_seconds       = 30
payment_queue_visibility_timeout_seconds          = 180
notification_queue_visibility_timeout_seconds     = 90
order_payment_result_queue_visibility_timeout_seconds = 180
max_receive_count = 5

outbox_batch_size          = 10
outbox_claim_lease_seconds = 120

queue_age_alarm_seconds  = 300
outbox_age_alarm_seconds = 300
alarm_evaluation_periods = 2

order_api_throttling_burst_limit = 20
order_api_throttling_rate_limit  = 10
order_api_authorization_type     = "AWS_IAM"

# NONE is available only for a short-lived, isolated demonstration. It is rejected when environment = "prod".
# order_api_authorization_type = "NONE"

# The deployment demo is deterministic and incurs no Product Service hosting cost.
product_adapter_mode = "SIMULATED"

# HTTP mode preserves the real synchronous Product boundary. The endpoint must be privately reachable;
# no NAT gateway is created.
# product_adapter_mode     = "HTTP"
# product_service_base_url = "http://product-service.internal:8082"
product_service_port     = 8082
product_service_cidr     = "10.42.0.0/16"

payment_database_name                     = "payments"
payment_database_username                 = "payment_admin"
payment_database_instance_class           = "db.t4g.micro"
payment_database_allocated_storage_gb     = 20
payment_db_max_pool_size                  = 2
payment_database_multi_az                 = false
payment_database_backup_retention_days    = 1
payment_database_deletion_protection      = false
payment_database_skip_final_snapshot      = true
payment_database_performance_insights     = false
