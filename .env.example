# Local development only. AWS credentials and production secrets must never be placed here.
PAYMENT_DB_NAME=payments
PAYMENT_DB_USERNAME=payment_local
PAYMENT_DB_PASSWORD=payment_local
PAYMENT_DB_PORT=5433

# LocalStack Hobby is free for personal/non-commercial learning, but current images require an
# account auth token. Copy this file to .env and set the token locally. Never commit the token.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_IMAGE=localstack/localstack:2026.8.0
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
LOCAL_AWS_REGION=us-east-1
LOCALSTACK_LAMBDA_DOCKER_NETWORK=aws-serverless-ecommerce_default
LOCALSTACK_LAMBDA_RUNTIME_ENVIRONMENT_TIMEOUT=60

# These are deliberately fake local emulator credentials, not AWS account credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# Use these values when invoking Payment Lambda code against local PostgreSQL.
DB_URL=jdbc:postgresql://localhost:5433/payments?sslmode=disable
DB_USERNAME=payment_local
DB_PASSWORD=payment_local
DB_MAX_POOL_SIZE=2
PAYMENT_PROCESSING_LEASE_SECONDS=60
OUTBOX_BATCH_SIZE=10
OUTBOX_CLAIM_LEASE_SECONDS=120

# SIMULATED uses the deterministic demo catalog (prod-001 and prod-002).
PRODUCT_ADAPTER_MODE=SIMULATED

# Required only when PRODUCT_ADAPTER_MODE=HTTP.
PRODUCT_SERVICE_BASE_URL=http://localhost:8082
PRODUCT_SERVICE_TIMEOUT_MS=5000
ORDER_CURRENCY=CLP
